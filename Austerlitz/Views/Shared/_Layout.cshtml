<!DOCTYPE><html ng-app="austerlitzModule">
<head>
    <meta charset="utf-8" />

    <base href="/" />

    <title>Austerlitz</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/cerulean-theme-bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/ng-grid.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/angular.rangeSlider.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-2.1.1.min.js"></script>
    <script src="~/Scripts/angular.js"></script>
    <script src="~/Scripts/angular-route.js"></script>
    <script src="~/Scripts/angular-sanitize.js"></script>
    <script src="~/Scripts/angular.rangeSlider.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/angular-ui-bootstrap/0.11.0/ui-bootstrap-tpls.min.js"></script>
    <script>
        if (window.angular) {
            try {
                window.angular.module('ui.bootstrap');
            } catch (e) {
                // Keep app bootstrap alive if CDN is unavailable.
                window.angular.module('ui.bootstrap', []);
            }
        }
    </script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/ng-grid.js"></script>
    <script src="~/Scripts/libs/smart-table.debug.js"></script>

    <script src="~/App/App.js"></script>
    <script src="~/App/rulesCatalogFactory.js"></script>
    <script src="~/App/turnSheetFactory.js"></script>
    <script src="~/App/turnReportFactory.js"></script>
    <script src="~/App/turnDataLoaderService.js"></script>
    <script src="~/App/turnSheetValueRulesFactory.js"></script>
    <script src="~/App/ts01TransferGoodsUtilsFactory.js"></script>
    <script src="~/App/setUpBrigadesSharedFactory.js"></script>
    <script src="~/App/setUpTransferPipelineFactory.js"></script>
    <script src="~/App/masterDataFactory.js"></script>
    <script src="~/App/bgModalController.js"></script>

    <script src="~/App/menuController.js"></script>
    <script src="~/App/homeController.js"></script>
    <script src="~/App/landUnits/landUnitsStateFactory.js"></script>
    <script src="~/App/landUnits/landUnitsModelFactory.js"></script>
    <script src="~/App/landUnits/landUnitsEffectsFactory.js"></script>
    <script src="~/App/landUnits/landUnitsTurnSheetFactory.js"></script>
    <script src="~/App/landUnits/landUnitsReplayFactory.js"></script>
    <script src="~/App/landUnits/landUnitsFederationFactory.js"></script>
    <script src="~/App/landUnits/landUnitsHeadcountTrainFactory.js"></script>
    <script src="~/App/landUnits/landUnitsBattalionOrdersFactory.js"></script>
    <script src="~/App/landUnits/landUnitsRenameFactory.js"></script>
    <script src="~/App/landUnits/landUnitsUiFactory.js"></script>
    <script src="~/App/landUnits/landUnitsSetUpBrigadesFactory.js"></script>
    <script src="~/App/landUnitsController.js"></script>
    <script src="~/App/mathBattlesCombatHelperFactory.js"></script>
    <script src="~/App/mathBattlesController.js"></script>
    <script src="~/App/mathBattlesStatsController.js"></script>
    <script src="~/App/sectionPlaceholderController.js"></script>
    <script src="~/App/navalUnits/navalUnitsStateFactory.js"></script>
    <script src="~/App/navalUnits/navalUnitsModelFactory.js"></script>
    <script src="~/App/navalUnits/navalUnitsSetUpFactory.js"></script>
    <script src="~/App/navalUnits/navalUnitsFederationFactory.js"></script>
    <script src="~/App/navalUnits/navalUnitsRepairFactory.js"></script>
    <script src="~/App/navalUnitsController.js"></script>

    <script src="~/App/turnMaps/turnMapsConfigFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsSharedFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsBoardingFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsProductionSitesFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsDepotLookupFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsTsTransferBuilderFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsTransferGoodsStorageFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsSetUpBrigadesFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsFormFederationsFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsMovementFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsGridConfigFactory.js"></script>
    <script src="~/App/turnMapsController.js"></script>

    <script src="~/App/turnSheet/turnSheetSectionsFactory.js"></script>
    <script src="~/App/turnSheet/turnSheetAllSectionsController.js"></script>
    <script src="~/App/turnSheet/turnSheetReadOnlySectionController.js"></script>
</head>

<body ng-controller="menuController">
    <div class="appShell" ng-init="init();">
        <header class="appTopBanner" ng-style="getMenuBarStyle()">
            <div class="appBannerLeft">
                <a href="/" class="appBannerCountry appBannerCountryLink">{{getSelectedStateName()}}</a>
                <span class="appBannerDivider">|</span>
                <span>AU-{{masterData.selectedGameNo || '--'}}</span>
                <span class="appBannerDivider">|</span>
                <span>{{getSelectedMonthYearText() || masterData.turnId}}</span>
            </div>
            <div class="appBannerRight">
                <span>{{masterData.turnId}}</span>
            </div>
        </header>

        <aside class="appSidebar">
            <div class="appSidebarTitle">
                <div class="appSidebarCountry">{{getSelectedStateName()}}</div>
                <div class="appSidebarGame">AU-{{masterData.selectedGameNo || '--'}}</div>
            </div>

            <div class="appSidebarTurnSelector">
                <label for="sidebarSelectedGameNo">Game</label>
                <select id="sidebarSelectedGameNo" class="form-control input-sm" ng-options="gameNo for gameNo in sidebarGameNoOptions" ng-model="sidebarSelectedGameNo" ng-change="onSidebarGameNoChanged()">
                    <option value="">-- game --</option>
                </select>

                <label for="sidebarSelectedState">State</label>
                <select id="sidebarSelectedState" class="form-control input-sm" ng-options="state for state in sidebarStateOptions" ng-model="sidebarSelectedState" ng-change="onSidebarStateChanged()">
                    <option value="">-- state --</option>
                </select>

                <label for="sidebarSelectedMonthYear">Turn</label>
                <select id="sidebarSelectedMonthYear" class="form-control input-sm" ng-options="monthYear for monthYear in sidebarMonthYearOptions" ng-model="sidebarSelectedMonthYear" ng-change="onSidebarMonthYearChanged()">
                    <option value="">-- turn --</option>
                </select>
            </div>

            <nav class="appSidebarNav">
                <a href="/home" ng-class="{ active: isActive('/home') }">Overview</a>
                <a href="/Section/Economy" ng-class="{ active: isActive('/Section/Economy') }">Economy</a>
                <a href="/Military/Brigades" ng-class="{ active: isActive('/Military') }">Army</a>
                <a href="/Military/MathBattles" ng-class="{ active: isActive('/Military/MathBattles') && !isActive('/Military/MathBattles/Stats') }">Math Battles</a>
                <a href="/Military/MathBattles/Stats" ng-class="{ active: isActive('/Military/MathBattles/Stats') }">-Stats</a>
                <a href="/Section/Naval" ng-class="{ active: isActive('/Section/Naval') }">Navy</a>
                <a href="/Section/Diplomacy" ng-class="{ active: isActive('/Section/Diplomacy') }">Diplomacy</a>
                <a href="/Section/Battles" ng-class="{ active: isActive('/Section/Battles') }">Battles</a>
                <a href="/TurnMaps" ng-class="{ active: isActive('/TurnMaps') }">Map</a>
                <a href="/Section/Intelligence" ng-class="{ active: isActive('/Section/Intelligence') }">Intelligence</a>
                <div class="dropdown appSidebarGroup" ng-class="{ active: isActive('/TurnSheet') }">
                    <a href="" class="dropdown-toggle appSidebarGroupLink" data-toggle="dropdown" ng-click="$event.preventDefault()">
                        Turnsheet <span class="caret"></span>
                    </a>
                    <div class="dropdown-menu appSidebarSubNav">
                        <a href="/TurnSheet">All Sections</a>
                        <a href="/TurnSheet/TransferGoods">TS_01 Transfer Goods</a>
                        <a href="/TurnSheet/DemolishItems">TS_02 Demolish Items</a>
                        <a href="/TurnSheet/SetUpBrigades">TS_03 Set Up Brigades</a>
                        <a href="/TurnSheet/SetUpAdditionalBrigades">TS_04 Additional Brigades</a>
                        <a href="/TurnSheet/IncreaseHeadcount">TS_05 Increase Headcount</a>
                        <a href="/TurnSheet/IncreaseBrigadeXP">TS_06 Increase Brigade XP</a>
                        <a href="/TurnSheet/ExchangeBattalions">TS_07 Exchange Battalions</a>
                        <a href="/TurnSheet/MergeBattalions">TS_08 Merge Battalions</a>
                        <a href="/TurnSheet/RepairShips_BaggageTrains">TS_09 Repair Ships</a>
                        <a href="/TurnSheet/BuildShips">TS_10 Build Ships</a>
                        <a href="/TurnSheet/BuildBaggageTrain">TS_11 Build Baggage Train</a>
                        <a href="/TurnSheet/IncreasePopulationDensity">TS_12 Population Density</a>
                        <a href="/TurnSheet/BuildProductionSites">TS_13 Production Sites</a>
                        <a href="/TurnSheet/FormFederations">TS_14 Form Federations</a>
                        <a href="/TurnSheet/CoastalDefence">TS_15 Coastal Defence</a>
                        <a href="/TurnSheet/SeaBlockade">TS_16 Sea Blockade</a>
                        <a href="/TurnSheet/TradeAndLoading1">TS_17 Trade & Loading 1</a>
                        <a href="/TurnSheet/Movement">TS_18 Movement</a>
                        <a href="/TurnSheet/TradeAndLoading2">TS_19 Trade & Loading 2</a>
                        <a href="/TurnSheet/Boarding">TS_20 Boarding</a>
                        <a href="/TurnSheet/HandOverTerritory">TS_21 Hand Over Territory</a>
                        <a href="/TurnSheet/ChangeNames">TS_22 Change Names</a>
                        <a href="/TurnSheet/ChangeStateRelationships">TS_23 Relationships</a>
                    </div>
                </div>
                <button type="button" class="btn btn-default btn-xs appSidebarSave appSidebarTurnsheetAction" ng-click="clearTurnOrders($event)">Clear Turn Orders</button>
                <button type="button" class="btn btn-default btn-xs appSidebarSave appSidebarTurnsheetAction" ng-click="saveTurnsheetSpreadsheet($event)">Save to Spreadsheet</button>
            </nav>
        </aside>

        <main class="appMainContent" ng-view="">
            @RenderBody()
        </main>
    </div>
</body>

</html>
