<!DOCTYPE><html ng-app="austerlitzModule">
<head>
    <meta charset="utf-8" />

    <base href="/" />

    <title>Austerlitz</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/cerulean-theme-bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/ng-grid.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/angular.rangeSlider.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-2.1.1.min.js"></script>
    <script src="~/Scripts/angular.js"></script>
    <script src="~/Scripts/angular-route.js"></script>
    <script src="~/Scripts/angular-sanitize.js"></script>
    <script src="~/Scripts/angular.rangeSlider.js"></script>

    <script src="//angular-ui.github.io/bootstrap/ui-bootstrap-tpls-0.11.0.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/ng-grid.js"></script>
    <script src="~/Scripts/libs/smart-table.debug.js"></script>

    <script src="~/App/App.js"></script>
    <script src="~/App/rulesCatalogFactory.js"></script>
    <script src="~/App/turnSheetFactory.js"></script>
    <script src="~/App/turnReportFactory.js"></script>
    <script src="~/App/turnDataLoaderService.js"></script>
    <script src="~/App/masterDataFactory.js"></script>
    <script src="~/App/bgModalController.js"></script>

    <script src="~/App/menuController.js"></script>
    <script src="~/App/homeController.js"></script>

    <script src="~/App/turnMaps/turnMapsConfigFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsSharedFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsBoardingFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsProductionSitesFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsSetUpBrigadesFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsFormFederationsFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsMovementFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsGridConfigFactory.js"></script>
    <script src="~/App/turnMapsController.js"></script>

    <script src="~/App/turnSheet/turnSheetSectionController.js"></script>
</head>

<body style="padding-top:60px" ng-controller="menuController">
    <header>
        <div class="nav navbar-default navbar-fixed-top stateMenuBar" ng-style="getMenuBarStyle()">
            <div class="container-fluid">

                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#main-nav">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a href="/home" class="navbar-brand menuTurnTitle">
                        <div class="menuCountryTitle">{{getSelectedStateName()}}</div>
                    </a>
                </div>

                <div class="collapse navbar-collapse" id="main-nav">
                    <ul class="nav navbar-nav">

                        <li ng-class="{ active: isActive('/TurnMaps') }"><a href="/TurnMaps">Turn Maps</a></li>

                        <li class="dropdown" ng-class="{ active: isActive('/TurnSheet') }">
                            <a href="" class="dropdown-toggle" data-toggle="dropdown" role="button">
                                Turn Sheet <span class="caret"></span>
                            </a>
                            <ul class="dropdown-menu ts-dropdown-menu">
                                <li class="dropdown-header">Land Forces</li>
                                <li><a href="/TurnSheet/SetUpBrigades">TS_03 Set Up Brigades</a></li>
                                <li><a href="/TurnSheet/SetUpAdditionalBrigades">TS_04 Set Up Additional Brigades</a></li>
                                <li><a href="/TurnSheet/IncreaseHeadcount">TS_05 Increase Headcount</a></li>
                                <li><a href="/TurnSheet/IncreaseBrigadeXP">TS_06 Increase Brigade XP</a></li>
                                <li><a href="/TurnSheet/ExchangeBattalions">TS_07 Exchange Battalions</a></li>
                                <li><a href="/TurnSheet/MergeBattalions">TS_08 Merge Battalions</a></li>
                                <li><a href="/TurnSheet/BuildBaggageTrain">TS_11 Build Baggage Train</a></li>
                                <li role="separator" class="divider"></li>
                                <li class="dropdown-header">Naval</li>
                                <li><a href="/TurnSheet/RepairShips_BaggageTrains">TS_09 Repair Ships &amp; Baggage Trains</a></li>
                                <li><a href="/TurnSheet/BuildShips">TS_10 Build Ships</a></li>
                                <li><a href="/TurnSheet/CoastalDefence">TS_15 Coastal Defence</a></li>
                                <li><a href="/TurnSheet/SeaBlockade">TS_16 Sea Blockade</a></li>
                                <li><a href="/TurnSheet/Boarding">TS_20 Boarding</a></li>
                                <li role="separator" class="divider"></li>
                                <li class="dropdown-header">Economics &amp; Territory</li>
                                <li><a href="/TurnSheet/TransferGoods">TS_01 Transfer Goods</a></li>
                                <li><a href="/TurnSheet/DemolishItems">TS_02 Demolish Items</a></li>
                                <li><a href="/TurnSheet/IncreasePopulationDensity">TS_12 Increase Population Density</a></li>
                                <li><a href="/TurnSheet/BuildProductionSites">TS_13 Build Production Sites</a></li>
                                <li><a href="/TurnSheet/TradeAndLoading1">TS_17 Trade &amp; Loading (Part 1)</a></li>
                                <li><a href="/TurnSheet/TradeAndLoading2">TS_19 Trade &amp; Loading (Part 2)</a></li>
                                <li><a href="/TurnSheet/HandOverTerritory">TS_21 Hand Over Territory</a></li>
                                <li role="separator" class="divider"></li>
                                <li class="dropdown-header">Movement &amp; Diplomacy</li>
                                <li><a href="/TurnSheet/FormFederations">TS_14 Form Federations</a></li>
                                <li><a href="/TurnSheet/Movement">TS_18 Movement</a></li>
                                <li><a href="/TurnSheet/ChangeNames">TS_22 Change Names</a></li>
                                <li><a href="/TurnSheet/ChangeStateRelationships">TS_23 Change State Relationships</a></li>
                            </ul>
                        </li>

                        <li class="menuSpreadsheetSaveItem"><a href="" ng-click="saveTurnsheetSpreadsheet($event)">Save Spreadsheet</a></li>
                        <li class="menuTurnInfoItem" ng-class="{ active: isActive('/home') }">
                            <a href="/home">
                                <div class="menuTurnRow"><span class="menuTurnValue">AU-{{masterData.selectedGameNo}}</span></div>
                                <div class="menuTurnRow"><span class="menuTurnValue">{{getSelectedMonthYearText()}}</span></div>
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </header>

    <main ng-init="init();" ng-view="">
        @RenderBody()
    </main>

    <footer class="container" style="padding:60px">
        <div class="nav navbar-default navbar-fixed-bottom stateMenuBar stateMenuBarBottom" ng-style="getMenuBarStyle()">
            <div class="container-fluid">
                <div class="stateMenuBarBottomCode">AU-{{masterData.selectedGameNo}}</div>
            </div>
        </div>
    </footer>
</body>

</html>
