<!DOCTYPE><html ng-app="austerlitzModule">
<head>
    <meta charset="utf-8" />

    <base href="/" />

    <title>Austerlitz</title>
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/cerulean-theme-bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/ng-grid.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/angular.rangeSlider.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-2.1.1.min.js"></script>
    <script src="~/Scripts/angular.js"></script>
    <script src="~/Scripts/angular-route.js"></script>
    <script src="~/Scripts/angular-sanitize.js"></script>
    <script src="~/Scripts/angular.rangeSlider.js"></script>

    <script src="//angular-ui.github.io/bootstrap/ui-bootstrap-tpls-0.11.0.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/ng-grid.js"></script>
    <script src="~/Scripts/libs/smart-table.debug.js"></script>

    <script src="~/App/App.js"></script>
    <script src="~/App/rulesCatalogFactory.js"></script>
    <script src="~/App/simBattleFactory.js"></script>
    <script src="~/App/turnSheetFactory.js"></script>
    <script src="~/App/turnReportFactory.js"></script>
    <script src="~/App/turnDataLoaderService.js"></script>
    <script src="~/App/masterDataFactory.js"></script>
    <script src="~/App/bgModalController.js"></script>

    <script src="~/App/menuController.js"></script>

    <script src="~/App/homeController.js"></script>
    <script src="~/App/brigadeCalculatorController.js"></script>
    <script src="~/App/simBattleController.js"></script>
    <script src="~/App/turnMaps/turnMapsConfigFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsSharedFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsBoardingFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsProductionSitesFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsSetUpBrigadesFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsFormFederationsFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsMovementFactory.js"></script>
    <script src="~/App/turnMaps/turnMapsGridConfigFactory.js"></script>
    <script src="~/App/turnMapsController.js"></script>
    <script src="~/App/boardingController.js"></script>
    <script src="~/App/turnSheetController.js"></script>
</head>

          <body style="padding-top:60px" ng-controller="menuController" >
              <header>
                  <div class="nav navbar-default navbar-fixed-top stateMenuBar" ng-style="getMenuBarStyle()">
                      <div class="container-fluid">

                          <div class="navbar-header">
                              <a href="/home" class="navbar-brand menuTurnTitle">
                                  <div class="menuCountryTitle">{{getSelectedStateName()}}</div>
                              </a>
                          </div>
                          <div class="navbar-collapse collapse stateMenuLinks">
                              <ul class="nav navbar-nav">
                                  <li ng-class="{ active: isActive('/TurnMaps') }"><a href="/TurnMaps">Turn Maps</a></li>
                                  <li ng-class="{ active: isActive('/BrigadeCalculator') }"><a href="/BrigadeCalculator">BrigadeCalculator</a></li>
                                  <li ng-class="{ active: isActive('/Boarding') }"><a href="/Boarding">Boarding</a></li>
                                  <li ng-class="{ active: isActive('/SimBattle') }"><a href="/SimBattle">Sim Battles</a></li>
                                  <li class="menuSpreadsheetSaveItem"><a href="" ng-click="saveTurnsheetSpreadsheet($event)">Save Spreadsheet</a></li>
                                  <li class="menuTurnInfoItem" ng-class="{ active: isActive('/home') }"><a href="/home"><div class="menuTurnRow"><span class="menuTurnValue">AU-{{masterData.selectedGameNo}}</span></div><div class="menuTurnRow"><span class="menuTurnValue">{{getSelectedMonthYearText()}}</span></div></a></li>
                              </ul>
                          </div>
                      </div>
                  </div>
              </header>

              <main ng-init="init();" ng-view="">
                  @RenderBody()
              </main>

              <footer class="container" style="padding:60px">
                  <div class="nav navbar-default navbar-fixed-bottom stateMenuBar stateMenuBarBottom" ng-style="getMenuBarStyle()">
                      <div class="container-fluid">
                          <div class="stateMenuBarBottomCode">AU-{{masterData.selectedGameNo}}</div>
                      </div>
                  </div>
              </footer>
          </body>

</html>

